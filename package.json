{
  "name": "game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unity-runner": "node --test scripts/tests/unity-preflight.node.mjs scripts/tests/unity-execution.node.mjs",
    "unity:inventory": "node scripts/unity-preflight.mjs --mode inventory",
    "unity:preflight": "node scripts/unity-preflight.mjs --mode preflight",
    "unity:validate": "node scripts/unity-validate.mjs",
    "trace:baseline": "node --experimental-strip-types scripts/trace-baseline.mjs",
    "parity:write": "node --experimental-strip-types scripts/combat-parity.mjs --write",
    "parity:check": "node --experimental-strip-types scripts/combat-parity.mjs --check",
    "record:route": "node scripts/record-route.mjs",
    "typecheck": "tsc",
    "package:itch": "npm run build && node scripts/package-itch.mjs",
    "check": "npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "three": "^0.186.0"
  }
}
