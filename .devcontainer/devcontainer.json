{
  "name": "Changshan Longdan - Node 22",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22-bookworm",
  "remoteUser": "node",
  "postCreateCommand": "npm ci --no-audit --no-fund",
  "forwardPorts": [
    5173,
    4173
